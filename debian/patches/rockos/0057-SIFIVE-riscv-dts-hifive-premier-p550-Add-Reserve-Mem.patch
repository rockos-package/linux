From 1f8ab61f9cdc58854c53f5a5f0e9c9fcef4901ef Mon Sep 17 00:00:00 2001
From: Pritesh Patel <pritesh.patel@einfochips.com>
Date: Thu, 20 Nov 2025 18:50:02 +0530
Subject: [PATCH 057/102] SIFIVE: riscv: dts: hifive-premier-p550: Add Reserve
 Memory Node

FROM: https://github.com/sifiveinc/riscv-linux/commit/60c35a60a63edf01fdfce9d963823cedd18a9587

Signed-off-by: Pritesh Patel <pritesh.patel@einfochips.com>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../dts/eswin/eic7700-hifive-premier-p550.dts    | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
index 0fccec245cf7..f6d22cecfff2 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
@@ -5,6 +5,8 @@
 
 /dts-v1/;
 
+#define CMA_SIZE        0x20000000
+
 #include "eic7700.dtsi"
 
 / {
@@ -23,6 +25,20 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 CMA_SIZE>;
+			alignment = <0x0 0x1000>;
+			linux,cma-default;
+		};
+	};
+
 	vcc_1v8: vcc1v8 {
 		 compatible = "regulator-fixed";
 		 regulator-name = "vcc1v8";
-- 
2.47.3

