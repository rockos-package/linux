From 5fde61635902392355c76777101b464136240c62 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Tue, 5 May 2026 23:26:07 +0800
Subject: [PATCH 063/102] SIFIVE: riscv: dts: eswin: add pvt node

FROM: https://github.com/sifiveinc/riscv-linux/commit/5fb85458f0cbe70c539e0e7d44fe62557582894a

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/eswin/eic7700.dtsi | 27 ++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700.dtsi b/arch/riscv/boot/dts/eswin/eic7700.dtsi
index f0377102dcc4..e88f741a39d9 100644
--- a/arch/riscv/boot/dts/eswin/eic7700.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700.dtsi
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/clock/eswin,eic7700-clock.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/reset/eswin,eic7700-reset.h>
 #include <dt-bindings/riscv/physical-memory.h>
@@ -573,6 +574,32 @@ gpioD: gpio-port@3 {
 			};
 		};
 
+		pvt0: pvt@0x50b00000 {
+			compatible = "eswin,eic7700-pvt";
+			reg = <0x0 0x50b00000 0x0 0x10000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			#thermal-sensor-cells = <0>;
+			clocks = <&clk EIC7700_CLK_GATE_LSP_PVT0_CLK>;
+			interrupts = <349>;
+			interrupt-parent = <&plic>;
+			label = "pvt0";
+			resets = <&reset EIC7700_RESET_PVT0>;
+		};
+
+		pvt1: pvt@0x52360000 {
+			compatible = "eswin,eic7700-pvt";
+			reg = <0x0 0x52360000 0x0 0x20000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			#thermal-sensor-cells = <0>;
+			clocks = <&clk EIC7700_CLK_GATE_LSP_PVT1_CLK>;
+			interrupts = <350>;
+			interrupt-parent = <&plic>;
+			label = "pvt1";
+			resets = <&reset EIC7700_RESET_PVT1>;
+		};
+
 		pinctrl: pinctrl@51600080 {
 			compatible = "eswin,eic7700-pinctrl";
 			reg = <0x0 0x51600080 0x0 0x1fff80>;
-- 
2.47.3

