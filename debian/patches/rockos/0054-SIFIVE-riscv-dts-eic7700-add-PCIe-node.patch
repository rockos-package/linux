From c4cb62fc5f02f6dbdf7ce3d92d579242ba65fa86 Mon Sep 17 00:00:00 2001
From: Pritesh Patel <pritesh.patel@einfochips.com>
Date: Thu, 20 Nov 2025 18:41:41 +0530
Subject: [PATCH 54/99] SIFIVE: riscv: dts: eic7700: add PCIe node

FROM: https://github.com/sifiveinc/riscv-linux/commit/c687334fbbd15d9156f9269693fd26b7633fa7d5

Signed-off-by: Pritesh Patel <pritesh.patel@einfochips.com>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/eswin/eic7700.dtsi | 43 ++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700.dtsi b/arch/riscv/boot/dts/eswin/eic7700.dtsi
index 6dfab43b2031..4c2212238257 100644
--- a/arch/riscv/boot/dts/eswin/eic7700.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700.dtsi
@@ -505,5 +505,48 @@ reset: reset-controller@51828300 {
 			reg = <0x0 0x51828300 0x0 0x200>;
 			#reset-cells = <1>;
 		};
+
+		pcie: pcie@54000000 {
+			compatible = "eswin,eic7700-pcie";
+			reg = <0x0 0x54000000 0x0 0x4000000>,
+				<0x0 0x40000000 0x0 0x800000>,
+				<0x0 0x50000000 0x0 0x100000>;
+			reg-names = "dbi", "config", "elbi";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			#interrupt-cells = <1>;
+			ranges = <0x01000000 0x0 0x40800000 0x0 0x40800000 0x0 0x800000>,
+					<0x02000000 0x0 0x41000000 0x0 0x41000000 0x0 0xf000000>,
+					<0x43000000 0x80 0x00000000 0x80 0x00000000 0x2 0x00000000>;
+			bus-range = <0x00 0xff>;
+			clocks = <&clk 144>,
+					<&clk 145>,
+					<&clk 146>,
+					<&clk 147>;
+			clock-names = "mstr", "dbi", "phy_reg", "aux";
+			resets = <&reset 97>,
+					<&reset 98>;
+			reset-names = "dbi", "pwr";
+			interrupts = <220>, <179>, <180>, <181>, <182>, <183>, <184>, <185>, <186>;
+			interrupt-names = "msi", "inta", "intb", "intc", "intd";
+			interrupt-parent = <&plic>;
+			interrupt-map-mask = <0x0 0x0 0x0 0x7>;
+			interrupt-map = <0x0 0x0 0x0 0x1 &plic 179>,
+				<0x0 0x0 0x0 0x2 &plic 180>,
+				<0x0 0x0 0x0 0x3 &plic 181>,
+				<0x0 0x0 0x0 0x4 &plic 182>;
+			device_type = "pci";
+			status = "disabled";
+			pcie@0 {
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+				device_type = "pci";
+				num-lanes = <4>;
+				resets = <&reset 99>;
+				reset-names = "perst";
+			};
+		};
 	};
 };
-- 
2.53.0

