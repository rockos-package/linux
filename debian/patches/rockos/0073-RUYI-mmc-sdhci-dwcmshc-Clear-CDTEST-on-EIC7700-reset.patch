From 4e6a2ff66cf6448a6a6df05b05430cdf04a29910 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Sun, 10 May 2026 18:56:48 +0800
Subject: [PATCH 73/99] RUYI: mmc: sdhci-dwcmshc: Clear CDTEST on EIC7700 reset
 to fix card removal detection

After SDHCI_RESET_ALL, the SDHCI_CTRL_CDTEST_INS and SDHCI_CTRL_CDTEST_EN
bits may be set, causing the CARD_PRESENT bit to latch high and preventing
broken-cd from detecting card removal via PRESENT_STATE polling.

Clear these bits after reset so card detect works correctly.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 drivers/mmc/host/sdhci-of-dwcmshc.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/host/sdhci-of-dwcmshc.c b/drivers/mmc/host/sdhci-of-dwcmshc.c
index 4b547c89138d..f3cf5bfca371 100644
--- a/drivers/mmc/host/sdhci-of-dwcmshc.c
+++ b/drivers/mmc/host/sdhci-of-dwcmshc.c
@@ -1338,8 +1338,16 @@ static void sdhci_eic7700_reset(struct sdhci_host *host, u8 mask)
 	dwcmshc_reset(host, mask);
 
 	/* after reset all, the phy's config will be clear */
-	if (mask == SDHCI_RESET_ALL)
+	if (mask == SDHCI_RESET_ALL) {
+		u8 ctrl;
+
+		/* Clear CDTEST to allow real card detect via PRESENT_STATE */
+		ctrl = sdhci_readb(host, SDHCI_HOST_CONTROL);
+		ctrl &= ~(SDHCI_CTRL_CDTEST_INS | SDHCI_CTRL_CDTEST_EN);
+		sdhci_writeb(host, ctrl, SDHCI_HOST_CONTROL);
+
 		sdhci_eic7700_config_phy(host);
+	}
 }
 
 static int sdhci_eic7700_reset_init(struct device *dev, struct eic7700_priv *priv)
