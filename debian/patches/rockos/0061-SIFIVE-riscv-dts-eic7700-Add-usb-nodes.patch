From d74e148fae0ad180270c90735bf4b66c7136807b Mon Sep 17 00:00:00 2001
From: Pritesh Patel <pritesh.patel@einfochips.com>
Date: Fri, 21 Nov 2025 12:37:06 +0530
Subject: [PATCH 061/102] SIFIVE: riscv: dts: eic7700: Add usb nodes

FROM: https://github.com/sifiveinc/riscv-linux/commit/87874f6c01682ea82a3836036e0951ad39676a95

Signed-off-by: Pritesh Patel <pritesh.patel@einfochips.com>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/eswin/eic7700.dtsi | 50 ++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700.dtsi b/arch/riscv/boot/dts/eswin/eic7700.dtsi
index c928326b1693..f0377102dcc4 100644
--- a/arch/riscv/boot/dts/eswin/eic7700.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700.dtsi
@@ -426,6 +426,56 @@ sdio0: mmc@0x50460000{
 			status = "disabled";
 		};
 
+		usb0: usb@50480000 {
+			compatible = "eswin,eic7700-dwc3";
+			reg = <0x0 0x50480000 0x0 0x10000>;
+			clocks = <&clk 186>,
+					<&clk 171>,
+					<&hspcrg 15>;
+			clock-names = "aclk", "cfg_clk", "usb_en";
+			interrupt-parent = <&plic>;
+			interrupts = <85>;
+			interrupt-names = "peripheral";
+			resets = <&reset 84>, <&hspcrg 2>;
+			reset-names = "vaux", "usb_rst";
+			dr_mode = "host";
+			phy_type = "utmi";
+			wakeup-source;
+			snps,dis_enblslpm_quirk;
+			snps,dis-u2-freeclk-exists-quirk;
+			snps,dis_u2_susphy_quirk;
+			snps,dis-del-phy-power-chg-quirk;
+			snps,parkmode-disable-ss-quirk;
+			maximum-speed = "high-speed";
+			eswin,hsp-sp-csr = <&hsp_sp_csr 0x800 0x818>;
+			status = "disabled";
+		};
+
+		usb1: usb@50490000 {
+			compatible = "eswin,eic7700-dwc3";
+			reg = <0x0 0x50490000 0x0 0x10000>;
+			clocks = <&clk 186>,
+					<&clk 171>,
+					<&hspcrg 16>;
+			clock-names = "aclk", "cfg_clk", "usb_en";
+			interrupt-parent = <&plic>;
+			interrupts = <86>;
+			interrupt-names = "host";
+			resets = <&reset 85>, <&hspcrg 3>;
+			reset-names = "vaux", "usb_rst";
+			dr_mode = "host";
+			phy_type = "utmi";
+			snps,dis_enblslpm_quirk;
+			snps,dis-u2-freeclk-exists-quirk;
+			snps,dis_u2_susphy_quirk;
+			snps,dis-del-phy-power-chg-quirk;
+			snps,parkmode-disable-ss-quirk;
+			maximum-speed = "high-speed";
+			wakeup-source;
+			eswin,hsp-sp-csr = <&hsp_sp_csr 0x900 0x918>;
+			status = "disabled";
+		};
+
 		uart0: serial@50900000 {
 			compatible = "snps,dw-apb-uart";
 			reg = <0x0 0x50900000 0x0 0x10000>;
-- 
2.47.3

