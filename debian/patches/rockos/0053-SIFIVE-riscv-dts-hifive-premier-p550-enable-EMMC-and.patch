From 524d213c93f7aec867437597d9f03530d2dd3a38 Mon Sep 17 00:00:00 2001
From: Pritesh Patel <pritesh.patel@einfochips.com>
Date: Thu, 20 Nov 2025 12:43:56 +0530
Subject: [PATCH 53/99] SIFIVE: riscv: dts: hifive-premier-p550: enable EMMC
 and SD card

FROM: https://github.com/sifiveinc/riscv-linux/commit/70c727faff8114d58486747d18927d626c66eed3

Signed-off-by: Pritesh Patel <pritesh.patel@einfochips.com>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../boot/dts/eswin/eic7700-hifive-premier-p550.dts     | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
index 4e09ad738d3d..ae39d151b4de 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
@@ -12,6 +12,8 @@ / {
 	model = "SiFive HiFive Premier P550";
 
 	aliases {
+		mmc0 = &sdhci_emmc;
+		mmc1 = &sdio0;
 		serial0 = &uart0;
 		ethernet0 = &gmac0;
 		ethernet1 = &gmac1;
@@ -259,6 +261,14 @@ gmac1_phy0: ethernet-phy@0 {
 	};
 };
 
+&sdhci_emmc {
+	status = "okay";
+};
+
+&sdio0 {
+	status = "okay";
+};
+
 &uart0 {
 	status = "okay";
 };
-- 
2.53.0

