From 6e858761d13650cfeafdc94126932b8b6da3604a Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 6 May 2026 20:27:51 +0800
Subject: [PATCH 66/99] RUYI: riscv: dts: hifive-premier-p550: enable pwm

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../boot/dts/eswin/eic7700-hifive-premier-p550.dts  | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
index ae9fd2a5fdb0..19555c5af2d8 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
@@ -228,6 +228,13 @@ gpio111-pins {
 			bias-disable;
 		};
 	};
+
+	pinctrl_pwm0: pwm0-grp {
+		pwm0-pins {
+			pins = "fan_pwm";
+			function = "pwm";
+		};
+	};
 };
 
 &gmac0 {
@@ -312,3 +319,9 @@ &usb0 {
 &usb1 {
 	status = "okay";
 };
+
+&pwm0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_pwm0>;
+};
-- 
2.53.0

