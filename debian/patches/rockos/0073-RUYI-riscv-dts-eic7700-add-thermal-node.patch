From 95f3508466f4919250d66a7979f52554db7934e5 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 6 May 2026 23:52:13 +0800
Subject: [PATCH 073/102] RUYI: riscv: dts: eic7700: add thermal node

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/eswin/eic7700.dtsi | 39 ++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7700.dtsi b/arch/riscv/boot/dts/eswin/eic7700.dtsi
index 9b6a760a237d..5b129dc6e112 100644
--- a/arch/riscv/boot/dts/eswin/eic7700.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700.dtsi
@@ -251,6 +251,45 @@ xtal24m: oscillator {
 		#clock-cells = <0>;
 	};
 
+	thermal-zones {
+		thermal0 {
+			polling-delay-passive = <100>; /*ms*/
+			polling-delay = <1000>; /*ms*/
+			sustainable-power = <30000>; /*mW*/
+			thermal-sensors = <&pvt0>;
+
+			trips {
+				threshold: trip-point0 {
+					temperature = <65000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
+				target: trip-point1 {
+					temperature = <75000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
+				crit: trip-point2 {
+					temperature     = <105000>;
+					hysteresis      = <0>;
+					type            = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&target>;
+					contribution = <1024>;
+					cooling-device =
+						<&cpu0 0 10>,
+						<&cpu1 0 10>,
+						<&cpu2 0 10>,
+						<&cpu3 0 10>;
+				};
+			};
+		};
+	};
+
 	soc {
 		compatible = "simple-bus";
 		ranges;
-- 
